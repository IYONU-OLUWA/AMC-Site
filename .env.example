# Copy this file to .env and fill in real values. Never commit .env itself.

# Get a free Postgres database at https://neon.tech or https://supabase.com
# It will look like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign login sessions
SESSION_SECRET="change-this-to-a-long-random-string"

# Port the app runs on locally (Render sets its own automatically)
PORT=3000
