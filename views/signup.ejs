<%- include('partials/header') %>

<div class="auth-split">
  <div class="auth-visual">
    <span class="eyebrow">Old students welcome</span>
    <h1>Join the<br><span class="accent">AMC Alumni</span><br>Community</h1>
    <p>Reconnect with classmates, hear about reunions, and stay part of the Ajoshe Model College family.</p>
  </div>
  <div class="auth-form-side">
    <div class="form-card">
      <h2>Create Your Account</h2>
      <p class="sub">An admin will review and approve your profile before it appears in the directory.</p>
      <form action="/signup" method="POST" enctype="multipart/form-data">
        <label for="fullName">Full Name</label>
        <input type="text" id="fullName" name="fullName" required>

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" minlength="8" required>

        <label for="confirmPassword">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" required>

        <label for="gradYear">Graduation Year</label>
        <input type="number" id="gradYear" name="gradYear" placeholder="e.g. 2015">

        <label for="occupation">Current Occupation</label>
        <input type="text" id="occupation" name="occupation" placeholder="e.g. Software Engineer">

        <label for="location">Current Location</label>
        <input type="text" id="location" name="location" placeholder="e.g. Lagos, Nigeria">

        <label for="photo">Profile Photo (optional)</label>
        <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp">
        <p style="font-size:0.78rem; color:#4a5568; margin-top:4px;">JPG, PNG, or WEBP — under 2MB. You can also add this later.</p>

        <button type="submit" class="btn btn-green form-submit">Create Account</button>
      </form>
      <div class="form-foot">Already have an account? <a href="/login" style="color:var(--green-dark); font-weight:600;">Log in</a></div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>