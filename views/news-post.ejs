<%- include('partials/header') %>

<section class="page-hero small">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--gold);">News</span>
    <h1><%= post.title %></h1>
  </div>
</section>

<section>
  <div class="wrap" style="max-width:720px;">
    <% if (post.coverImage) { %>
      <img src="<%= post.coverImage %>" alt="" style="border-radius:16px; margin-bottom:24px;">
    <% } %>
    <p style="color:#8a94a3; font-size:0.85rem; margin-bottom:20px;">By <%= post.author.fullName %> · <%= post.createdAt.toDateString() %></p>
    <div style="color:#333; white-space:pre-line; line-height:1.8;"><%= post.body %></div>
    <a href="/news" style="display:inline-block; margin-top:32px; color:var(--green-dark); font-weight:600;">← Back to news</a>
  </div>
</section>

<%- include('partials/footer') %>
