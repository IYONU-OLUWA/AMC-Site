<%- include('partials/admin-header') %>

<div class="admin-topbar">
  <h1 style="font-size:1.5rem;">Events</h1>
</div>

<div class="grid-2">
  <div>
    <h3 style="margin-bottom:14px;">Upcoming &amp; Past Events</h3>
    <% if (events.length === 0) { %>
      <p style="color:#5B6478;">No events added yet.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Title</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% events.forEach(function(ev){ %>
            <tr>
              <td><%= ev.title %></td>
              <td><%= ev.startsAt.toDateString() %></td>
              <td>
                <form action="/admin/events/<%= ev.id %>/delete" method="POST" onsubmit="return confirm('Remove this event?');">
                  <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h3 style="margin-bottom:14px;">Add an Event</h3>
    <form action="/admin/events" method="POST">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required>

      <label for="startsAt">Date &amp; Time</label>
      <input type="datetime-local" id="startsAt" name="startsAt" required>

      <label for="location">Location</label>
      <input type="text" id="location" name="location">

      <label for="description">Description</label>
      <textarea id="description" name="description"></textarea>

      <button type="submit" class="btn btn-primary" style="margin-top:18px;">Add Event</button>
    </form>
  </div>
</div>

<%- include('partials/admin-footer') %>
