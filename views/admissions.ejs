<%- include('partials/header') %>

<section class="page-hero small">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--gold);">Admissions</span>
    <h1>Joining Ajoshe Model College</h1>
  </div>
</section>

<section>
  <div class="wrap grid-2">
    <div class="box-lightblue">
      <h2 style="margin-bottom:14px;">Admission Process</h2>
      <p style="color:white; white-space:pre-line;"><%= info %></p>
    </div>
    <div class="box-lightblue">
      <h2 style="margin-bottom:14px;">External Exams</h2>
      <p style="color:white; white-space:pre-line;"><%= exams %></p>
      <div class="card" style="margin-top:20px;">
        <h3 style="font-size:1rem; margin-bottom:10px; color: white;">Exam Registration Contact</h3>
        <p style="color:white; font-size:0.92rem;">
          NEPTEB · WAEC · NECO registration<br>
          Call: <a href="tel:07069067827" style="color:var(--green-dark); font-weight:600;">0706 906 7827</a><br>
          Call: <a href="tel:07030114270" style="color:var(--green-dark); font-weight:600;">0703 011 4270</a>
        </p>
      </div>
    </div>
  </div>
</section>

<section style="background:#032942; border-top:1px solid var(--line);">
  <div class="wrap" style="max-width:600px;">
    <img src="/images/exam-registration-flyer.png" alt="AMC exam registration flyer for NEPTEB, WAEC, NECO" style="border-radius:16px; border:1px solid var(--line); box-shadow:var(--shadow);">
  </div>
</section>

<%- include('partials/footer') %>
