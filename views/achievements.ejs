<%- include('partials/header') %>

<section class="page-hero small">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--gold);">Achievements</span>
    <h1>Moments AMC is proud of</h1>
  </div>
</section>

<section style="background-color: #069bd6;">
  <div class="wrap">
    <p style="color:#4a5568; white-space:pre-line; max-width:70ch; margin-bottom:36px;"><%= achievements %></p>

    <div class="grid-2">
      <div class="card">
        <img src="/images/achievement-2nd-runner-up.png" alt="2nd Runner Up award" style="border-radius:12px; margin-bottom:16px;">
        <h3 style="font-size:1.1rem; color: #069bd6;">2nd Runner Up</h3>
        <p style="color:white; font-size:0.9rem; margin-top:6px;">Enterprise &amp; Model Global Young Talents Initiative — Master High School Debate Competition. Awarded ₦30,000, 3rd March 2025.</p>
      </div>
      <div class="card">
        <img src="/images/achievement-punctuality-award.jpg" alt="Punctuality Award" style="border-radius:12px; margin-bottom:16px;">
        <h3 style="font-size:1.1rem; color: #069bd6;">Punctuality Award</h3>
        <p style="color:white; font-size:0.9rem; margin-top:6px;">Inter-School Design Competition — awarded ₦10,000 for outstanding punctuality.</p>
      </div>
    </div>
  </div>
</section>

<section style="background:#8ea8aa5b; border-top:1px solid var(--line);">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Official visits</span>
      <h2>AMC hosting officials on campus</h2>
    </div>
    <div class="photo-grid">
      <figure><img src="/images/event-officials-visit-1.jpg" alt="Officials meeting at AMC"><figcaption>Official meeting on campus</figcaption></figure>
      <figure><img src="/images/event-officials-visit-2.jpg" alt="Officials touring AMC grounds"><figcaption>Campus tour with officials</figcaption></figure>
      <figure><img src="/images/event-classroom-visit.jpg" alt="Officials visiting an AMC classroom"><figcaption>Classroom visit</figcaption></figure>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
