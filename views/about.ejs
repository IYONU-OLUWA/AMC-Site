<%- include('partials/header') %>

<section class="page-hero small">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--gold);">About</span>
    <h1>The story of Ajoshe Model College</h1>
  </div>
</section>

<section>
  <div class="wrap grid-2">
    <div>
      <h2 style="margin-bottom:14px;">Our History</h2>
      <p style="color:#4a5568; white-space:pre-line;"><%= history %></p>
    </div>
    <div>
      <h2 style="margin-bottom:14px;">Our Mission</h2>
      <p style="color:#4a5568; white-space:pre-line;"><%= mission %></p>
    </div>
  </div>
</section>

<section style="background:#fff; border-top:1px solid var(--line);">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Our campus</span>
      <h2>Facilities on the ground</h2>
    </div>
    <div class="photo-grid">
      <figure>
        <img src="/images/facility-science-lab.jpg" alt="Science Laboratory Complex exterior">
        <figcaption>Science Laboratory Complex</figcaption>
      </figure>
      <figure>
        <img src="/images/facility-lab-interior-1.jpg" alt="Inside the science laboratory">
        <figcaption>Laboratory — student orientation</figcaption>
      </figure>
      <figure>
        <img src="/images/facility-lab-interior-2.jpg" alt="Inside the science laboratory">
        <figcaption>Laboratory facilities</figcaption>
      </figure>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
